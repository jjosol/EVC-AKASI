generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model doctor {
  doctor_id Int    @unique(map: "doctor_id") @default(autoincrement())
  username  String @db.VarChar(225)
  password  String @db.VarChar(225)
  gmail     String @db.VarChar(225)
  name      String @db.VarChar(225)
  
  consultation_records consultation_records[]
  medAdministration    medAdministration[]

  @@id([doctor_id, username])
}

model nurse {
  nurse_id Int    @unique(map: "nurse_id") @default(autoincrement())
  username String @db.VarChar(225)
  password String @db.VarChar(225)
  gmail    String @db.VarChar(225)
  name     String @db.VarChar(225)

  hsu_bulletin         hsu_bulletin[]
  consultation_records consultation_records[]
  medAdministration    medAdministration[]
  equipment_edits      EditsEquipment[] 
  inventory_edits      EditsMedicine[] 

  @@id([nurse_id, username])
}

model patient {
  patient_id Int    @unique(map: "patient_id") @default(autoincrement())
  username  String  @db.VarChar(225)
  password  String  @db.VarChar(225)
  name      String  @db.VarChar(225)
  gmail     String  @db.VarChar(225)
  age       Int
  gender    String  @db.VarChar(225)
  type      String  @db.VarChar(225) // 'student', 'faculty', 'staff', 'other'
  civil_status String  @db.VarChar(225) // 'single', 'married', 'widowed', 'separated'
  address   String  @db.VarChar(225)
  division String?  @db.VarChar(225) 
  position String?  @db.VarChar(225) // 'student', 'faculty', 'staff', 'other'
  grade     Int?
  section   String?  @db.VarChar(225)
  category  String? @db.VarChar(225) // Intern, Extern
  status    String  @default("pending") // 'pending', 'complete', 'ongoing', 'rejected'

  medAdministrations   medAdministration[]
  physical_exam        physical_exam[]
  opthal_certificates  opthal_certificates[]
  medical_certificates medical_certificates[]
  dental_certificates  dental_certificates[]
  consultation_records consultation_records[]
  appointment          appointment[]
  dental_consent       dental_consent[]
  medical_consent      medical_consent[]
  dental_history       dental_history[]
  hh_pds               hh_pds[]
  laboratory           laboratory[]

  @@id([patient_id, username])
}

model appointment {
  appointment_id Int      @id @unique(map: "appointment_id") @default(autoincrement())
  patient_id     Int
  date           DateTime @db.Date
  hour           Int
  minute         Int
  complaint      String   @db.VarChar(225)
  status         String   @default("pending") // 'pending', 'approved', 'rejected'
  notes          String?  @db.VarChar(500)

  patient patient @relation(fields: [patient_id], references: [patient_id], onDelete: NoAction, onUpdate: NoAction)
 
  @@index([patient_id], map: "FK_patient_TO_appointment")
}

model consultation_records {
  consultation_id    Int      @id @unique(map: "consultation_id") @default(autoincrement())
  patient_id         Int
  nurse_id           Int
  doctor_id          Int?
  date               DateTime @db.DateTime(0)
  patient_name       String   @db.VarChar(225)
  patient_occupation String   @db.VarChar(225)
  nurse_name         String   @db.VarChar(225)
  doctor_name        String?   @db.VarChar(225)
  complaint          String   @db.VarChar(225)
  remarks            String   @db.VarChar(500)
  intervention       String   @db.VarChar(500)
  action             String   @default("") @db.VarChar(500)
  confined           Boolean
  medAdministration  Boolean
  disposition        String   @default("") @db.VarChar(500)

  // Relations
  nurse              nurse                    @relation(fields: [nurse_id], references: [nurse_id], onDelete: NoAction, onUpdate: NoAction)
  patient            patient                 @relation(fields: [patient_id], references: [patient_id], onDelete: NoAction, onUpdate: NoAction)
  doctor             doctor?                   @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction)
  diagnosis          consultation_diagnosis[]
  medAdministrations medAdministration[]      @relation("ConsultationToMedAdministration")
  prescriptions      prescription[]

  @@index([nurse_id], map: "FK_nurse_TO_consultation_records")
  @@index([patient_id], map: "FK_patient_TO_consultation_records")
  @@index([doctor_id], map: "FK_doctor_TO_consultation_records")
}

model consultation_diagnosis {
  consultation_id Int
  diagnosis_id    Int

  consultation consultation_records @relation(fields: [consultation_id], references: [consultation_id], onDelete: Cascade)
  diagnosis    diagnosis            @relation(fields: [diagnosis_id], references: [diagnosis_id], onDelete: Cascade)

  @@id([consultation_id, diagnosis_id])
  @@index([consultation_id])
  @@index([diagnosis_id])
}

model diagnosis {
  diagnosis_id Int      @id @default(autoincrement())
  name         String   @db.VarChar(225)
  category_id  Int
  created_at   DateTime @default(now())
  created_by   Int
  active       Boolean  @default(true)

  // Relations
  category      diagnosis_category       @relation(fields: [category_id], references: [category_id])
  consultations consultation_diagnosis[]

  @@index([category_id])
  @@index([created_by])
}

model diagnosis_category {
  category_id Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(225)
  diagnoses   diagnosis[]
}

model medAdministration {
  med_administration_id Int      @id @default(autoincrement())
  consultation_id       Int
  patient_id            Int
  nurse_id              Int
  doctor_id             Int?
  med_id                Int
  medName               String   @db.VarChar(225)
  date                  DateTime @db.DateTime(0)
  patient_name          String   @db.VarChar(225)
  count                 Int
  schedule              String   @db.VarChar(225)
  start_date            DateTime @db.Date
  end_date              DateTime @db.Date
  remarks               String?  @db.VarChar(500)
  intervention          String?  @db.VarChar(500)

  // Relations
  nurse                nurse                @relation(fields: [nurse_id], references: [nurse_id], onDelete: NoAction, onUpdate: NoAction)
  patient              patient              @relation(fields: [patient_id], references: [patient_id], onDelete: NoAction, onUpdate: NoAction)
  doctor               doctor?              @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction)
  medicine             medicine             @relation(fields: [med_id, medName], references: [medicine_id, medName], onDelete: NoAction, onUpdate: NoAction)
  consultation_records consultation_records @relation("ConsultationToMedAdministration", fields: [consultation_id], references: [consultation_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([nurse_id], map: "FK_nurse_TO_medAdministration")
  @@index([patient_id], map: "FK_patient_TO_medAdministration")
  @@index([doctor_id], map: "FK_doctor_TO_medAdministration")
  @@index([med_id, medName])
}




model medicine {
  medicine_id Int      @default(autoincrement())
  medName     String   @db.VarChar(225)
  medCategory_id Int      @default(1)
  expiration  DateTime @db.Date
  count       Int
  otc         Boolean  @default(true) // Add OTC flag - true means over-the-counter (no prescription needed)

  // Relations
  category          medicineCategory    @relation(fields: [medCategory_id], references: [medCategory_id])
  EditsMedicine     EditsMedicine[]
  medAdministration medAdministration[]
  prescriptions     prescription[] // Add relation to prescriptions

  @@id([medicine_id, medName])
  @@index([medCategory_id])
}

model medicineCategory {
  medCategory_id Int               @id @default(autoincrement())
  name        String            @unique @db.VarChar(225)
  medicine    medicine[]
  edits       EditsMedicine[]
}

model EditsMedicine {
  edit_id      Int      @id @default(autoincrement())
  med_id       Int
  medName      String   @db.VarChar(225)
  date         DateTime @db.DateTime(0)
  cause        String   @db.VarChar(225)
  addSubCount  Int
  runningTotal Int // Add this to track total after each change
  category_id  Int // Add this to track medicine category
  nurse_id     Int // Make admin_id optional to handle existing records
  nurse        nurse   @relation(fields: [nurse_id], references: [nurse_id])


  category medicineCategory @relation(fields: [category_id], references: [medCategory_id])
  medicine medicine @relation(fields: [med_id, medName], references: [medicine_id, medName])

  @@index([med_id, medName])
  @@index([nurse_id])
  @@index([category_id]) // Add index for category_id
}


model prescription {
  prescription_id Int      @id @default(autoincrement())
  consultation_id Int
  medicine_id     Int? // Optional connection to medicine
  medName         String?  @db.VarChar(225)
  file_path       String?   @db.VarChar(255)  // Replace image Bytes with file path
  file_name       String?   @db.VarChar(100)  // Original filename
  mime_type       String?  @db.VarChar(50)   // File type (e.g., application/pdf)
  file_size       Int?     // Size in bytes
  date_uploaded   DateTime @default(now())
  notes           String?  @db.VarChar(500)

  // Relations
  consultation consultation_records @relation(fields: [consultation_id], references: [consultation_id], onDelete: Cascade)
  medicine     medicine?           @relation(fields: [medicine_id, medName], references: [medicine_id, medName], onDelete: SetNull)

  @@index([consultation_id])
  @@index([medicine_id, medName])
}


model equipment {
  equipment_id   Int        @id @default(autoincrement())
  equipName      String     @unique @db.VarChar(225)
  count          Int
  unit           String     @db.VarChar(225)
  expiration     DateTime?  @db.Date // Optional expiration date
  equipCategory_id Int      @default(1) // Add foreign key 
  category       equipmentCategory @relation(fields: [equipCategory_id], references: [medCategory_id]) // Add relation
  EditsEquipment EditsEquipment[]

  @@index([equipCategory_id]) // Add index for performance
  @@map("equipment")
}

model equipmentCategory {
  medCategory_id Int            @id @default(autoincrement())
  name        String            @unique @db.VarChar(225)
  equipment   equipment[]      
  edits       EditsEquipment[]
}

model EditsEquipment {
  edit_id      Int       @id @default(autoincrement())
  equipment_id Int
  equipName    String    @db.VarChar(225)
  date         DateTime  @db.DateTime(0)
  cause        String    @db.VarChar(225)
  addSubCount  Int
  runningTotal Int
  nurse_id     Int
  category_id  Int      // Add category ID to store the category
  nurse        nurse    @relation(fields: [nurse_id], references: [nurse_id])
  equipment    equipment @relation(fields: [equipment_id], references: [equipment_id])
  category     equipmentCategory @relation(fields: [category_id], references: [medCategory_id])

  @@index([equipment_id])
  @@index([nurse_id])
  @@index([category_id])
}

model dental_certificates {
  patient_id Int
  grade     Int?
  date      DateTime @db.Date
  file_path       String   @db.VarChar(255)  // Replace image Bytes with file path
  file_name       String   @db.VarChar(100)  // Original filename
  mime_type       String   @db.VarChar(50)   // File type (e.g., application/pdf)
  file_size       Int?     // Size in bytes
  dental_id Int      @id @default(autoincrement())
  status    String   @default("pending") // 'pending', 'complete', 'ongoing', 'rejected'
  notes     String?  @db.VarChar(500)

  patient   patient  @relation(fields: [patient_id], references: [patient_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([patient_id], map: "FK_patient_TO_dental_certificates")
}

model medical_certificates {
  patient_id  Int
  grade      Int?
  date       DateTime @db.Date
 file_path       String?   @db.VarChar(255)  // Replace image Bytes with file path
  file_name       String?   @db.VarChar(100)  // Original filename
  mime_type       String?  @db.VarChar(50)   // File type (e.g., application/pdf)
  file_size       Int?     // Size in bytes
  medical_id Int      @id @default(autoincrement())
  status     String   @default("pending") // 'pending', 'complete', 'ongoing', 'rejected'
  notes      String?  @db.VarChar(500)

  patient     patient @relation(fields: [patient_id], references: [patient_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([patient_id], map: "FK_patient_TO_medical_certificates")
}

