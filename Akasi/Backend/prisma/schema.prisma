model hh_pds {
  patient_id Int
  grade     Int?
  date      DateTime @db.Date
 file_path  String   @db.VarChar(255)  // Replace image Bytes with file path
  file_name String   @db.VarChar(100)  // Original filename
  mime_type String  @db.VarChar(50)   // File type (e.g., application/pdf)
  file_size Int   // Size in bytes
  hh_pds_id Int      @id @default(autoincrement())
  status    String   @default("pending") // 'pending', 'complete', 'ongoing', 'rejected'
  notes     String?  @db.VarChar(500)

  patient patient @relation(fields: [patient_id], references: [patient_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([patient_id], map: "FK_patient_TO_physical_exam")
}

model laboratory {
  patient_id     Int
  grade          Int?
  date          DateTime @db.Date
  file_path       String @db.VarChar(255)  // Replace image Bytes with file path
  file_name       String @db.VarChar(100)  // Original filename
  mime_type       String @db.VarChar(50)   // File type (e.g., application/pdf)
  file_size       Int  // Size in bytes
  laboratory_id Int      @id @default(autoincrement())
  type          String   @db.VarChar(225)
  status        String   @default("pending") // 'pending', 'complete', 'ongoing', 'rejected'
  notes         String?  @db.VarChar(500)

  patient patient @relation(fields: [patient_id], references: [patient_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([patient_id], map: "FK_patient_TO_physical_exam")
}

model hsu_bulletin {
  nurse_id   Int
  username   String               @db.VarChar(225)
  caption    String?              @db.VarChar(500)
  post_id    Int                  @id @default(autoincrement())
  created_at DateTime             @default(now())
  files      hsu_bulletin_files[]
  nurse      nurse                @relation(fields: [nurse_id], references: [nurse_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_nurse_TO_HSU_bulletin")

  @@index([nurse_id, username], map: "FK_nurse_TO_HSU_bulletin")
}

model hsu_bulletin_files {
  file_id    Int          @id @default(autoincrement())
  post_id    Int
  created_at DateTime     @default(now())
  file_path       String   @db.VarChar(255)  // Replace image Bytes with file path
  file_name       String   @db.VarChar(100)  // Original filename
  mime_type       String  @db.VarChar(50)   // File type (e.g., application/pdf)
  file_size       Int     // Size in bytes
  bulletin   hsu_bulletin @relation(fields: [post_id], references: [post_id])

  @@index([post_id], map: "HSU_bulletin_files_post_id_idx")
}

